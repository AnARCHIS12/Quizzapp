# Quizzapp Environment Variables Configuration Template
# Copy this file to .env and configure accordingly.

# 1. Database Connections
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quizzapp
DB_USER=root
DB_PASS=

# 2. WebSocket Configuration
# In production behind Pangolin / SSL Reverse Proxy:
# Leave WS_PORT empty so port 443 standard is used (wss://your-domain.com/ws)
# WS_HOST=quiz.votre-domaine.com
WS_HOST=
WS_PORT=
WS_URL=

# 3. JWT Core Security Salt
JWT_SECRET=quizzapp_super_secret_jwt_key_2026_change_me

# 4. SMTP Email Dispatch Setup
# If SMTP_HOST is left empty, the application falls back to localized logging in logs/mail.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls
MAIL_FROM_ADDRESS=no-reply@quizapp.local
MAIL_FROM_NAME=Quizzapp
SMTP_ALLOW_SELF_SIGNED=false

# 5. Mistral AI Integration — Provider 1 (Primary)
# Leave empty to disable Mistral. If all providers are empty, AI questions are disabled.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# 5b. Groq — Provider 2 (Fallback — FREE, ultra-fast, 14 400 req/day)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# 5c. OpenRouter — Provider 3 (Fallback — aggregator, many free models)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# AI Failover logic: providers are tried in order (Mistral → Groq → OpenRouter).
# On 429/402/503, the next provider is automatically used. At least one must be set.

# 6. Docker Registry Image Config (for build & push commands)
# DOCKER_IMAGE_PHP=votre-pseudo-dockerhub/quizzapp-php:latest
# DOCKER_IMAGE_WS=votre-pseudo-dockerhub/quizzapp-websocket:latest
